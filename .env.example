# Template for the key file of Dot: ~/Library/Application Support/Dot/.env (or $DOT_HOME/.env).
#
# Prefer `dotx auth set NAME`. It reads the value from the terminal without echoing it, writes the file with mode 0600
# and keeps the other entries. Edit the file by hand only if you must, and run `chmod 600` on it afterwards.
#
# A key is looked up in this order, and the first source that has it wins:
#   1. the environment of the process (for example `export OPENAI_API_KEY=...` before `dotx daemon`)
#   2. this file
#   3. the macOS Keychain: service "dot-agent", account = the variable name
#        security add-generic-password -s dot-agent -a OPENAI_API_KEY -w
#
# A daemon started by launchd (`dotx service install`) does not see the environment of your shell. Give it its keys
# through this file or the Keychain.
#
# Which variable a provider reads is set in config.toml: [providers.<name>] api_key_env.

# OpenAI API, for models written as "openai:<model>".
# OPENAI_API_KEY=
# Optional: bill a particular organization or project.
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=

# OpenCode Go, for models written as "opencode_go:<model>".
# OPENCODE_API_KEY=

# Anthropic API (the Claude models), for models written as "anthropic:<model>".
# ANTHROPIC_API_KEY=

# OpenRouter (the models of many labs on one key), for models written as "openrouter:<vendor>/<model>".
# OPENROUTER_API_KEY=

# Ollama. Not needed for the local server, and not for cloud models through it (`ollama signin` once). Needed for the
# hosted web search ([web] search_backend = "ollama") and when [providers.ollama] base_url points at ollama.com.
# OLLAMA_API_KEY=

# TypeSafe, for the typed judge ([judge] provider = "typesafe"; off by default). The variable is [judge] api_key_env.
# TYPESAFE_API_KEY=

# Not set here, because they decide where this file is: set them in the environment of the process.
#   DOT_HOME     the directory of everything Dot keeps (default ~/Library/Application Support/Dot)
#   DOT_LOG_DIR  the directory of the logs (default ~/Library/Logs/Dot)
