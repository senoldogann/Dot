{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dot",
  "version": "0.1.0",
  "identifier": "dev.dot.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/tools/uv": "tools/uv",
      "resources/tools/rg": "tools/rg",
      "resources/tools/dot-launcher": "tools/dot-launcher"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "Dot.entitlements"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzRTA4MTk1MzczN0UwMkEKUldRcTREYzNsWUhnQTVvSGpPQ1dVMU9iVjBLVEkvSHZ0ZmZMS0U1ZHBVc0g1MzdNcFVMdzBEdE8K",
      "endpoints": [
        "https://github.com/senoldogann/Dot/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
