# Python
__pycache__/
*.py[cod]
.venv/

# Tool caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Local configuration and secrets
.env

# Per-machine Claude Code settings
.claude/settings.local.json

# Desktop shell (Tauri)
desktop/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/gen/
# The permissions of the installer's commands, which the build script makes from the list in build.rs
desktop/src-tauri/permissions/autogenerated/
# The tools the app carries (uv, rg, the launcher): desktop/fetch-tools.sh puts them in the app's resources, a release
# signs them there. Only the note that says so is kept.
desktop/src-tauri/resources/tools/*
!desktop/src-tauri/resources/tools/README.md
# The versions the app installs Dot's dependencies at: desktop/release.sh makes the file from uv.lock for each release
desktop/src-tauri/resources/constraints.txt
# What desktop/release.sh builds, each release in its own folder
desktop/dist/

# Never tracked: the owner's working notes and reports, local data, logs, the real config
PLAN.md
reports/
config.toml
*.sqlite3
*.sqlite3-*
*.db
*.log
.DS_Store
# The AppleDouble files macOS writes beside a file on a volume without its extended attributes
._*
node_modules/
