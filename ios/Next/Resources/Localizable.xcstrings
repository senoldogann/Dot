    "%lld min": {
      "comment": "A short span of time: minutes\nWork line: how long the run has worked, in whole minutes",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dk"
          }
        }
      }
