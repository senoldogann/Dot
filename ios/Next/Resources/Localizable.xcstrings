    "%lld helpers": {
      "comment": "Helper group header, first part; the argument is how many helpers the run started\nHelpers group: how many helpers the run started",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld helper"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld helpers"
