{
  "sourceLanguage": "en",
  "strings": {
    "%@ (Recommended)": {
      "comment": "Ask dock: the option Dot recommends; the argument is its label",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (Önerilen)"
          }
        }
      }
    },
    "%@ + listed": {
      "comment": "Models: a custom provider also lists the models it offers",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ + listelenenler"
          }
        }
      }
    },
    "%@ MB": {
      "comment": "Maintenance › Performance: megabytes",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ MB"
          }
        }
      }
    },
    "%@ MB in · %@ MB out": {
      "comment": "Maintenance › Performance: megabytes read and sent",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ MB gelen · %2$@ MB giden"
          }
        }
      }
    },
    "%@ a minute": {
      "comment": "Maintenance › Performance: redraws per minute",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "dakikada %@"
          }
        }
      }
    },
    "%@ and %@": {
      "comment": "Work log: the last part of a group of tool calls joined to the others; the arguments are the parts",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ve %@"
          }
        }
      }
    },
    "%@ at %@": {
      "comment": "Schedule rhythm; short weekday names, then clock times",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ saat %@"
          }
        }
      }
    },
    "%@ is %@. The limit is 20 MiB per attachment.": {
      "comment": "Composer attachment error; arguments are file name and size",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ boyutu %@. Ek başına sınır 20 MiB."
          }
        }
      }
    },
    "%@ is %@. The limit is 200 MiB for a video or a sound.": {
      "comment": "Composer attachment error; arguments are file name and size",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ boyutu %@. Video veya ses için sınır 200 MiB."
          }
        }
      }
    },
    "%@ is not a Tailscale address. It ends in .ts.net; Settings › Phone on the Mac shows it.": {
      "comment": "Pairing error: the address is not under ts.net; the argument is the host",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bir Tailscale adresi değil. Adres .ts.net ile biter; Mac'te Ayarlar › Telefon gösterir."
          }
        }
      }
    },
    "%@ is off.": {
      "comment": "Watchers: one was switched off",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kapalı."
          }
        }
      }
    },
    "%@ is on.": {
      "comment": "Watchers: one was switched on",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ açık."
          }
        }
      }
    },
    "%@ is overloaded: %@": {
      "comment": "Manager review: an overloaded bot; the second argument is why",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ aşırı yüklü: %2$@"
          }
        }
      }
    },
    "%@ is working on it": {
      "comment": "Hand-off: the bot asked has not answered yet; the argument is its name",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ üzerinde çalışıyor"
          }
        }
      }
    },
    "%@ late": {
      "comment": "Work order: how late it is; the argument is a span such as 2 h",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gecikti"
          }
        }
      }
    },
    "%@ ms": {
      "comment": "Maintenance › Performance: milliseconds",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ms"
          }
        }
      }
    },
    "%@ of %@": {
      "comment": "Inspector cost row: tokens spent against the cap",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@"
          }
        }
      }
    },
    "%@ on": {
      "comment": "VoiceOver: a schedule's switch; the argument is its name",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ açık"
          }
        }
      }
    },
    "%@ ran nothing for %lld days and has no work order or routine": {
      "comment": "Manager review: an idle bot",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld gündür hiçbir şey yapmadı; iş emri ya da rutini yok"
          }
        }
      }
    },
    "%@ reviewed the team %@": {
      "comment": "Manager review: who reviewed and when; the second argument is a span such as 2 hours ago",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ekibi inceledi, %2$@"
          }
        }
      }
    },
    "%@ reviews": {
      "comment": "Bot profile: another bot reviews the team; the argument is its name",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ inceliyor"
          }
        }
      }
    },
    "%@ reviews the team now. Choosing how often here makes this bot the manager.": {
      "comment": "Manager review: another bot is the manager; the argument is its name",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekibi şu an %@ inceliyor. Sıklığı burada seçersen bu bot yönetici olur."
          }
        }
      }
    },
    "%@ s in %@ min open": {
      "comment": "Maintenance › Performance: CPU seconds used over minutes on screen",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ dk açıkken %1$@ sn"
          }
        }
      }
    },
    "%@ · %@ cached": {
      "comment": "Inspector cost row: tokens in and the share the provider had cached; first argument the tokens, second the share",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ önbellekten"
          }
        }
      }
    },
    "%@ · %lld tasks": {
      "comment": "Usage: a day's tokens and tasks",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld görev"
          }
        }
      }
    },
    "%@ · usually %@": {
      "comment": "Inspector cost row: tokens spent and what like tasks usually spend",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · genelde %@"
          }
        }
      }
    },
    "%@, failed": {
      "comment": "VoiceOver: a tool call that failed; the argument is its line",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, başarısız"
          }
        }
      }
    },
    "%@, in your Mac's time zone.": {
      "comment": "New schedule footer: the rhythm in words; repeats are read in the Mac's zone",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, Mac'inin saat diliminde."
          }
        }
      }
    },
    "%@, running": {
      "comment": "VoiceOver: a tool call at work; the argument is its line",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, çalışıyor"
          }
        }
      }
    },
    "%@: %lld of its %lld runs this week failed": {
      "comment": "Manager review: a bot whose runs fail",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: bu hafta %3$lld işinden %2$lld tanesi başarısız oldu"
          }
        }
      }
    },
    "%@; %lld denied": {
      "comment": "Away card: who decided, then how many of the decisions said no",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@; %lld reddedildi"
          }
        }
      }
    },
    "%lld / %lld": {
      "comment": "Ask dock: which ask is shown, \"1 / 3\"; the arguments are its place and the count",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld"
          }
        }
      }
    },
    "%lld actions": {
      "comment": "Agents: a number of tools",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld action"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld actions"
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld eylem"
          }
        }
      }
    },
    "%lld active": {
      "comment": "Bot profile: how many objectives are active",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld etkin"
          }
        }
      }
    },
    "%lld by the reviewer": {
      "comment": "Away card: decisions the review model made",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tanesi inceleyici tarafından"
          }
        }
      }
    },
    "%lld campaign sessions": {
      "comment": "Away card: sessions of campaigns that ran",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
