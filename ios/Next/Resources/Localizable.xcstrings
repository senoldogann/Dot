    },
    "%lld in %@ min": {
      "comment": "Maintenance › Performance: stream breaks over minutes open",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ dk'da %1$lld"
          }
        }
      }
