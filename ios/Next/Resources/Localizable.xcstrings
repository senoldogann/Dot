        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (Önerilen)"
          }
        }
      }
    },
    "%@, failed": {
      "comment": "VoiceOver: a tool call that failed; the argument is its line",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, başarısız"
          }
        }
      }
    },
