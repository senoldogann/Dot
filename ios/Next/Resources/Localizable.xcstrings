      }
    },
    "On: words appear as Dot writes them. Off: an answer appears once it is whole.": {
      "comment": "Description of the response streaming switch",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık: sözcükler Dot yazdıkça görünür. Kapalı: yanıt tamamlanınca bir kerede görünür."
          }
        }
      }
