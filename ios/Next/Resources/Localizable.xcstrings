      }
    },
    "On: a long line wraps. Off: it scrolls sideways.": {
      "comment": "Appearance: what word break does",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık: uzun satır alta kayar. Kapalı: yana kaydırılır."
          }
